# Copy to .env.local. Never commit .env.local.
# Exact origin used in the browser; update for production in Vercel.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Create a new sb_secret_ key in Supabase; never paste it in chat.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server-only random value with at least 32 characters.
CONTACT_RATE_LIMIT_SECRET=replace_with_a_random_32_character_value
# Never put either secret in NEXT_PUBLIC_ variables.
